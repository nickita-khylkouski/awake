#!/bin/bash
set -euo pipefail

VERSION="3.0.0"
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
APP_PATH="${AWAKE_APP_PATH:-$HOME/.local/bin/Awake.app}"
STATE_FILE="${AWAKE_STATE_FILE:-$HOME/.config/awake/state.json}"
COMMAND_FILE="${AWAKE_COMMAND_FILE:-$HOME/.config/awake/command}"
OPEN_BIN="${AWAKE_OPEN_BIN:-/usr/bin/open}"

usage() {
    cat <<'EOF'
Usage: awake <command>

  on | start | nosleep       Stay awake indefinitely
  for <15m|1h|3600s>         Stay awake for a duration
  until <HH:MM>              Stay awake until a local time
  off | stop | yessleep      Allow normal sleep
  nosleep-display            Stay awake while allowing display sleep
  blackout                   Black out all screens
  screens show               Restore blacked-out screens
  status [--json]            Show current state
  ui                         Open the menu bar app
  menu                       Open the Awake menu
  about                      Show Awake information
  install | uninstall        Install or remove Awake
EOF
}

send_url() {
    local value="$1" command
    "$OPEN_BIN" -g "$APP_PATH"
    case "$value" in
        awake://start\?seconds=*) command="start seconds ${value#*seconds=}" ;;
        awake://start\?display=*) command="start display ${value#*display=}" ;;
        awake://start) command="start" ;;
        awake://toggle) command="toggle" ;;
        awake://stop) command="stop" ;;
        awake://blackout) command="blackout" ;;
        awake://show) command="show" ;;
        awake://menu) command="menu" ;;
        awake://about) command="about" ;;
        *) echo "Invalid Awake command" >&2; return 2 ;;
    esac
    mkdir -p "$(dirname -- "$COMMAND_FILE")"
    local temporary="$COMMAND_FILE.$$"
    printf '%s\n' "$command" > "$temporary"
    mv "$temporary" "$COMMAND_FILE"
}

duration_seconds() {
    local value="${1:-}"
    [[ "$value" =~ ^([1-9][0-9]*)(s|m|h)$ ]] || {
        echo "Invalid duration: $value (use 30m, 2h, or 900s)" >&2
        return 2
    }
    local amount="${BASH_REMATCH[1]}"
    case "${BASH_REMATCH[2]}" in
        s) echo "$amount" ;;
        m) echo $((amount * 60)) ;;
        h) echo $((amount * 3600)) ;;
    esac
}

seconds_until() {
    local value="${1:-}"
    [[ "$value" =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || {
        echo "Invalid time: $value (use HH:MM)" >&2
        return 2
    }
    /usr/bin/python3 - "$value" <<'PY'
from datetime import datetime, timedelta
import sys
hour, minute = map(int, sys.argv[1].split(":"))
now = datetime.now()
end = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
if end <= now:
    end += timedelta(days=1)
print(max(1, int((end - now).total_seconds())))
PY
}

show_status() {
    local json='{"active":false,"blackout":false,"keepDisplayOn":false}'
    [ -f "$STATE_FILE" ] && json="$(tr -d '\n' < "$STATE_FILE")"
    if [ "${1:-}" = "--json" ]; then
        printf '%s\n' "$json"
        return
    fi
    /usr/bin/python3 - "$json" <<'PY'
import json, sys
try:
    state = json.loads(sys.argv[1])
except Exception:
    print("Awake status is unavailable")
    raise SystemExit(1)
if not state.get("active"):
    print("Awake is off")
elif state.get("remainingSeconds") is not None:
    seconds = max(0, int(state["remainingSeconds"]))
    print(f"Awake is on for {seconds // 60}:{seconds % 60:02d}")
else:
    print("Awake is on indefinitely")
print("Display: kept on" if state.get("keepDisplayOn") else "Display: may sleep")
PY
}

remove_legacy_runtime() {
    local domain="gui/$(id -u)"
    local label path
    for label in com.awake.runtime com.awake.daemon com.awake.lease-monitor com.awake.ui; do
        path="$HOME/Library/LaunchAgents/$label.plist"
        /bin/launchctl bootout "$domain/$label" 2>/dev/null || true
        [ ! -f "$path" ] || rm -f "$path"
    done
    rm -f "$HOME/Library/LaunchAgents/com.awake.ui.plist" "$HOME/Library/LaunchAgents/com.awake.ui.plist.disabled"
}

terminate_installed_app() {
    local pid command
    while read -r pid command; do
        case "$command" in
            "$APP_PATH/Contents/MacOS/Awake"|"$APP_PATH/Contents/MacOS/AwakeUI")
                kill "$pid" 2>/dev/null || true
                ;;
        esac
    done < <(/bin/ps -axo pid=,command=)
}

remove_legacy_integrations() {
    local claude_settings="$HOME/.claude/settings.json"
    if [ -f "$claude_settings" ]; then
        /usr/bin/python3 - "$claude_settings" <<'PY' || echo "Warning: could not remove legacy Claude hooks from $claude_settings" >&2
import json, os, sys, tempfile
path = sys.argv[1]
with open(path) as handle:
    config = json.load(handle)
hooks = config.get("hooks", {})
for event in list(hooks):
    hooks[event] = [entry for entry in hooks[event] if "awake-hook" not in json.dumps(entry)]
    if not hooks[event]:
        del hooks[event]
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".awake-cleanup-")
with os.fdopen(fd, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
os.replace(temporary, path)
PY
    fi

    local codex_config="$HOME/.codex/config.toml"
    if [ -f "$codex_config" ]; then
        /usr/bin/sed -i '' '/\.local\/bin\/awake-notify/d' "$codex_config"
    fi

    rm -f "$HOME/.local/bin/awake-hook" "$HOME/.local/bin/awake-notify" \
        "$HOME/.local/bin/awake-build-icon" "$HOME/.local/bin/awake-dashboard.html" "$HOME/.local/bin/awake-ui.py"
    rm -rf "$HOME/.local/bin/AwakeApp"

}

install_awake() {
    local build="$SCRIPT_DIR/awake-build-ui"
    [ -x "$build" ] || { echo "awake-build-ui was not found beside awake" >&2; return 1; }
    "$build"
    /usr/bin/caffeinate -i -t 15 >/dev/null 2>&1 &
    remove_legacy_runtime
    terminate_installed_app
    sleep 0.5
    "$OPEN_BIN" -g "$APP_PATH"
    sleep 1
    send_url "awake://start"
    remove_legacy_integrations
    echo "Awake is installed and active. Use its menu bar icon to control it."
}

uninstall_awake() {
    send_url "awake://stop" 2>/dev/null || true
    send_url "awake://show" 2>/dev/null || true
    terminate_installed_app
    remove_legacy_runtime
    remove_legacy_integrations
    rm -rf "$APP_PATH"
    rm -rf "$HOME/.local/bin/AwakeSource"
    rm -f "$HOME/.local/bin/awake-build-ui" "$HOME/.local/bin/awake-package.json"
    rm -f "$STATE_FILE" "$COMMAND_FILE"
    echo "Removed Awake.app. Remove this CLI separately if it was installed globally."
}

command="${1:-help}"
case "$command" in
    on|start|nosleep)
        send_url "awake://start"
        ;;
    toggle)
        send_url "awake://toggle"
        ;;
    nosleep-display)
        send_url "awake://start?display=0"
        ;;
    off|stop|yessleep|cancel-timer)
        send_url "awake://stop"
        ;;
    for)
        seconds="$(duration_seconds "${2:-}")"
        send_url "awake://start?seconds=$seconds"
        ;;
    until)
        seconds="$(seconds_until "${2:-}")"
        send_url "awake://start?seconds=$seconds"
        ;;
    blackout)
        send_url "awake://blackout"
        ;;
    screens)
        [ "${2:-}" = "show" ] || { echo "Usage: awake screens show" >&2; exit 2; }
        send_url "awake://show"
        ;;
    ui)
        "$OPEN_BIN" -g "$APP_PATH"
        ;;
    menu)
        send_url "awake://menu"
        ;;
    about)
        send_url "awake://about"
        ;;
    status)
        show_status "${2:-}"
        ;;
    sleep)
        echo "Awake never forces your Mac to sleep. Use the Apple menu or allow normal sleep with: awake off" >&2
        exit 2
        ;;
    install)
        install_awake
        ;;
    uninstall)
        uninstall_awake
        ;;
    -v|--version|version)
        echo "awake-agent $VERSION"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
