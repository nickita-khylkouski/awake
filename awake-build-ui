#!/bin/bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
if [ -f "$ROOT/ui/main.swift" ]; then
    SOURCE="$ROOT/ui/main.swift"
    PACKAGE_JSON="$ROOT/package.json"
else
    SOURCE="$ROOT/AwakeSource/main.swift"
    PACKAGE_JSON="$ROOT/awake-package.json"
fi
DESTINATION="${AWAKE_INSTALL_ROOT:-$HOME/.local/bin}"
APP="$DESTINATION/Awake.app"
BUILD_DIR="$(mktemp -d /tmp/awake-build.XXXXXX)"
STAGED_APP="$BUILD_DIR/Awake.app"
CONTENTS="$STAGED_APP/Contents"
VERSION="$(/usr/bin/python3 - "$PACKAGE_JSON" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))["version"])
PY
)"

cleanup() { rm -rf "$BUILD_DIR"; }
trap cleanup EXIT

[ -f "$SOURCE" ] || { echo "Missing $SOURCE" >&2; exit 1; }
mkdir -p "$CONTENTS/MacOS" "$CONTENTS/Resources" "$DESTINATION"

frameworks=(-framework AppKit -framework Carbon -framework IOKit -framework ServiceManagement -framework SwiftUI)
for arch in arm64 x86_64; do
    echo "Building Awake for $arch..."
    xcrun swiftc -O -target "$arch-apple-macos13.0" "${frameworks[@]}" \
        -o "$BUILD_DIR/Awake-$arch" "$SOURCE"
done
xcrun lipo -create "$BUILD_DIR/Awake-arm64" "$BUILD_DIR/Awake-x86_64" -output "$CONTENTS/MacOS/Awake"

cat > "$CONTENTS/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Awake</string>
  <key>CFBundleDisplayName</key><string>Awake</string>
  <key>CFBundleIdentifier</key><string>com.awake.menubar</string>
  <key>CFBundleExecutable</key><string>Awake</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><false/>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST

cp "$ROOT/awake-power" "$CONTENTS/Resources/awake-power"
if [ "$ROOT/awake" != "$DESTINATION/awake" ]; then cp "$ROOT/awake" "$DESTINATION/awake"; fi
if [ "$ROOT/awake-power" != "$DESTINATION/awake-power" ]; then cp "$ROOT/awake-power" "$DESTINATION/awake-power"; fi
if [ "$0" != "$DESTINATION/awake-build-ui" ]; then cp "$0" "$DESTINATION/awake-build-ui"; fi
mkdir -p "$DESTINATION/AwakeSource"
cp "$SOURCE" "$DESTINATION/AwakeSource/main.swift"
cp "$PACKAGE_JSON" "$DESTINATION/awake-package.json"
chmod +x "$DESTINATION/awake" "$DESTINATION/awake-power" "$DESTINATION/awake-build-ui" "$CONTENTS/MacOS/Awake" "$CONTENTS/Resources/awake-power"
/usr/bin/codesign --force --deep --sign - "$STAGED_APP"

NEW_APP="$DESTINATION/.Awake.app.new.$$"
PREVIOUS_APP="$DESTINATION/.Awake.app.previous.$$"
mv "$STAGED_APP" "$NEW_APP"
if [ -d "$APP" ]; then mv "$APP" "$PREVIOUS_APP"; fi
mv "$NEW_APP" "$APP"
rm -rf "$PREVIOUS_APP"

LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
[ ! -x "$LSREGISTER" ] || "$LSREGISTER" -f "$APP" >/dev/null 2>&1

echo "Installed $APP"
